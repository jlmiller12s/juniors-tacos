{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/catering",
      "destination": "/catering.html"
    },
    {
      "source": "/reviews",
      "destination": "/reviews.html"
    }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
